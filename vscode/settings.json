{
  // Language specific settings
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
  },

  // Auto sync settings
  "settingsSync.keybindingsPerPlatform": false,

  // Editor settings
  "breadcrumbs.enabled": false,
  "editor.cursorStyle": "line-thin",
  "editor.formatOnSave": true,
  "editor.lineNumbers": "relative",
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.suggest.insertMode": "replace",

  // Explorer settings
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  // Files settings
  "files.autoSave": "onFocusChange",

  // Git settings
  "git.confirmSync": false,

  // JavaScript settings
  "javascript.updateImportsOnFileMove.enabled": "always",

  // Red Hat settings
  "redhat.telemetry.enabled": false,

  // Terminal settings
  "terminal.integrated.customGlyphs": false,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font Mono",
  "terminal.integrated.suggest.enabled": false,

  // TypeScript settings
  "typescript.updateImportsOnFileMove.enabled": "always",

  // Workbench settings
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.statusBar.visible": true,

  // Zen Mode settings
  "zenMode.fullScreen": true,
  "zenMode.hideActivityBar": true,
  "zenMode.hideLineNumbers": false,
  "zenMode.hideStatusBar": true,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // Vim settings
  "vim.leader": "<Space>",
  "vim.hlsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.handleKeys": {
    "<C-d>": true,
    "<C-s>": false,
  },
  // Enable surround plugin https://github.com/tpope/vim-surround
  "vim.surround": true,
  "vim.normalModeKeyBindingsNonRecursive": [
    // NAVIGATION

    // switch b/w buffers
    { "before": ["<S-h>"], "commands": [":bprevious"] },
    { "before": ["<S-l>"], "commands": [":bnext"] },

    // splits
    { "before": ["leader", "v"], "commands": [":vsplit"] },
    { "before": ["leader", "s"], "commands": [":split"] },

    // panes
    {
      "before": ["leader", "h"],
      "commands": ["workbench.action.focusLeftGroup"],
    },
    {
      "before": ["leader", "j"],
      "commands": ["workbench.action.focusBelowGroup"],
    },
    {
      "before": ["leader", "k"],
      "commands": ["workbench.action.focusAboveGroup"],
    },
    {
      "before": ["leader", "l"],
      "commands": ["workbench.action.focusRightGroup"],
    },

    // NICE TO HAVE
    { "before": ["leader", "w"], "commands": [":w!"] },
    { "before": ["leader", "q"], "commands": [":q!"] },
    { "before": ["leader", "x"], "commands": [":x!"] },
    {
      "before": ["[", "d"],
      "commands": ["editor.action.marker.prev"],
    },
    {
      "before": ["]", "d"],
      "commands": ["editor.action.marker.next"],
    },
    {
      "before": ["<leader>", "c", "a"],
      "commands": ["editor.action.quickFix"],
    },
    {
      "before": ["leader", "f", "f"],
      "commands": ["workbench.action.quickOpen"],
    },
    { "before": ["leader", "p"], "commands": ["editor.action.formatDocument"] },
    {
      "before": ["g", "h"],
      "commands": ["editor.action.showDefinitionPreviewHover"],
    },
    {
      "before": ["g", "d"],
      "commands": ["editor.action.goToTypeDefinition"],
    },
  ],
  "vim.visualModeKeyBindings": [
    // Stay in visual mode while indenting
    { "before": ["<"], "commands": ["editor.action.outdentLines"] },
    { "before": [">"], "commands": ["editor.action.indentLines"] },
    // Move selected lines while staying in visual mode
    { "before": ["J"], "commands": ["editor.action.moveLinesDownAction"] },
    { "before": ["K"], "commands": ["editor.action.moveLinesUpAction"] },
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": ["p"],
      "commands": ["editor.action.clipboardPasteAction"],
    },
  ],

  // Set keyboard.dispatch to keyCode to fix some issue with key remapping in Gnome Tweak
  "keyboard.dispatch": "keyCode",
  "git.suggestSmartCommit": false,
  "makefile.configureOnOpen": true,
  "diffEditor.ignoreTrimWhitespace": true,
  "yaml.schemas": {
    "https://json.schemastore.org/bitbucket-pipelines.json": "bitbucket-pipelines.yml",
  },
  "git.blame.editorDecoration.enabled": true,
  "biome.suggestInstallingGlobally": false,
  "claudeCode.preferredLocation": "panel",
  "claudeCode.disableLoginPrompt": true,
  "claudeCode.selectedModel": "claude-opus-4-6",
  "python.defaultInterpreterPath": "python3",
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "terminal.integrated.scrollback": 10000,
  "json.schemaDownload.trustedDomains": {
    "http://json.schemastore.org": true,
    "https://biomejs.dev": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true,
  },
}
