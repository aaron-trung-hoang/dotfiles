[user]
  name = Anthony Hoang Quoc Trung

[core]
  editor = code --wait
  autocrlf = input
  excludesfile = ~/.gitignore_global
  preloadindex = true
  fscache = true

[color]
  ui = auto

[format]
  pretty = format:%C(auto,yellow)%h%C(auto,magenta)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset

